{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix client ci --include=dev && npm --prefix client run build",
    "migrate:up": "node-pg-migrate up -m db/migrations",
    "migrate:down": "node-pg-migrate down -m db/migrations",
    "migrate:create": "node-pg-migrate create -m db/migrations --migration-file-language sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
